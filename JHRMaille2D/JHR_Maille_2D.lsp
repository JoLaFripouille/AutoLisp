(defun wm:ui (/ dll result keys vals product)
 (if (not (member "JHR:MAILLE-DIALOG-V131" (atoms-family 1)))
  (progn
   (setq dll (if *wm:ui-root* (strcat *wm:ui-root* "/JhrMailleUi_v1_3_1.dll") (findfile "JhrMailleUi_v1_3_1.dll")))
   (if (or (not dll) (not (findfile dll)))
    (wm:fail "Interface absente. NETLOAD JhrMailleUi_v1_3_1.dll du dossier complet, ou utiliser JHRMAILLECLI."))
   (command-s "_.NETLOAD" dll)))
 (if (not (member "JHR:MAILLE-DIALOG-V131" (atoms-family 1)))
  (wm:fail "Interface non chargee. Verifier le chargement .NET, ou utiliser JHRMAILLECLI."))
 (setq product (wm:product-current))
 (setq result (apply 'jhr:maille-dialog-v131
  (append (list (wm:cfg 'ml) (wm:cfg 'mw) (wm:cfg 'wire) (wm:cfg 'lace) (wm:cfg 'gap)
   (* 180.0 (/ (wm:cfg 'angle) pi)) (wm:cfg 'woven) (wm:cfg 'corner-auto)
   (wm:cfg 'sleeve-l) (wm:cfg 'sleeve-h) (wm:cfg 'stops) (if product (car product) ""))
   (list *wm:tool*) *wm:patterns*)))
 ;; The managed ResultBuffer wraps a Nil value as (nil), not nil.
 (if (equal result '(nil)) (setq result nil))
 (if result
  (progn
   (if (or (/= (length result) 39)
       (not (vl-every 'numberp (rf:take 11 result)))
       (not (vl-every '(lambda (x) (= (type x) 'STR)) (rf:take 3 (wm:tail 11 result))))
       (not (vl-every 'numberp (wm:tail 14 result))))
    (wm:fail "Reponse invalide de l interface. Aucun parametre modifie."))
   (setq keys '(ml mw wire lace gap angle woven corner-auto sleeve-l sleeve-h stops) vals result)
   (while keys
    (wm:set (car keys) (cond ((= (car keys) 'angle) (* pi (/ (car vals) 180.0)))
      ((member (car keys) '(woven corner-auto stops)) (fix (car vals))) (T (car vals))))
    (setq keys (cdr keys) vals (cdr vals)))
   (setq *wm:product* (if (/= (nth 11 result) "") (rf:take 3 (wm:tail 11 result)) nil)
     *wm:product-stamp* (if *wm:product* (wm:product-stamp) nil)
     *wm:tool* (fix (nth 14 result)) *wm:patterns* (wm:tail 15 result)) T)))
(defun c:JHRMAILLE (/ *error* wm:reason)
 (defun *error* (msg) (if wm:reason (princ (strcat "\n" wm:reason))) (princ))
 (if (not (member (getvar "INSUNITS") '(0 4))) (wm:fail "Dessiner en millimetres avant de lancer JHRMAILLE."))
 (if (/= (getvar "TILEMODE") 1) (wm:fail "Lancer la commande dans l espace objet."))
 (if (wm:ui) (c:JHRMAILLECLI) (princ "\nAnnule. Aucun objet ni parametre modifie.")) (princ))
(defun c:JHRMAILLEPARAM (/ *error* wm:reason)
 (defun *error* (msg) (if wm:reason (princ (strcat "\n" wm:reason))) (princ))
 (if (wm:ui) (princ "\nParametres memorises pour cette session. Lancer JHRMAILLE.")
   (princ "\nAnnule. Parametres conserves.")) (princ))
(defun rf:prepare (inside outside ang / obj lo hi)
  (setq wm:reason nil)
  (wm:validate inside) (wm:validate outside)
  (if (and (equal inside outside) (not (and (= *wm:tool* 1) (= (fix (nth 7 (rf:opts))) 0)))) (wm:fail "Les deux contours doivent etre differents."))
  (if (> (abs (- (cond ((cdr (assoc 38 (entget inside)))) (T 0.0)) (cond ((cdr (assoc 38 (entget outside)))) (T 0.0)))) 0.01)
    (wm:fail "Les deux contours doivent etre coplanaires."))
  (setq obj (vlax-ename->vla-object inside)) (vla-GetBoundingBox obj 'lo 'hi)
  (setq lo (vlax-safearray->list lo) hi (vlax-safearray->list hi)
    wm:origin (mapcar '(lambda (a b) (/ (+ a b) 2.0)) (list (car lo) (cadr lo)) (list (car hi) (cadr hi)))
    wm:angle ang wm:inner (wm:poly inside) wm:outer (wm:poly outside))
  (if (< (wm:area wm:inner) 0) (setq wm:inner (reverse wm:inner)))
  (if (< (wm:area wm:outer) 0) (setq wm:outer (reverse wm:outer)))
  (if (or (wm:selfcross wm:inner) (wm:selfcross wm:outer)) (wm:fail "Contour croise ou auto-intersectant."))
  (if (and (not (equal inside outside)) (or (not (vl-every '(lambda (p) (wm:inside p wm:outer)) wm:inner))
          (vl-some '(lambda (a) (vl-some '(lambda (b) (wm:hit (car a) (cadr a) (car b) (cadr b))) (wm:edges wm:outer))) (wm:edges wm:inner))))
    (wm:fail "Le contour exterieur doit entourer strictement le contour interieur sans le couper."))
  lo)

;; Other filling tools. Cable geometry is preserved; new panels use descriptive names.
(defun rf:take (n items / out) (repeat n (setq out (cons (car items) out) items (cdr items))) (reverse out))
(defun rf:opts () (rf:take 8 (wm:tail (* 8 (1- *wm:tool*)) *wm:patterns*)))
(defun rf:setopts (values / head tail)
 (setq head (rf:take (* 8 (1- *wm:tool*)) *wm:patterns*) tail (wm:tail (* 8 *wm:tool*) *wm:patterns*))
 (setq *wm:patterns* (append head values tail)))
(defun rf:validate (v / a b wire thick gap ang margin mode)
 (setq a (nth 0 v) b (nth 1 v) wire (nth 2 v) thick (nth 3 v) gap (nth 4 v) ang (nth 5 v) margin (nth 6 v) mode (fix (nth 7 v)))
 (if (or (<= a 0) (<= b 0) (<= wire 0) (<= thick 0) (< gap 0) (< margin 0) (> (abs ang) 360) (/= (nth 7 v) mode))
  (wm:fail "Parametres du remplissage invalides."))
 (cond
  ((= *wm:tool* 1) (if (or (>= wire a) (< mode 0) (> mode 2)) (wm:fail "Le fil doit etre plus petit que l ouverture libre ; mode 0=un contour, 1=deux visibles, 2=deux caches.")))
  ((= *wm:tool* 2) (if (or (< a b) (>= wire (/ (min a b) 3.0)) (< mode 0) (> mode 1)) (wm:fail "Verifier les diagonales et la largeur de laniere du deploye.")))
  ((= *wm:tool* 3) (if (or (>= a b) (< mode 0) (> mode 2)) (wm:fail "Le trou doit etre plus petit que l entraxe.")))
  (T (wm:fail "Outil de remplissage inconnu."))) v)
(defun rf:offset (en gap / wm:inner) (setq wm:inner (wm:poly en)) (wm:offset en gap))
(defun rf:bounds (poly) (list (apply 'min (mapcar 'car poly)) (apply 'min (mapcar 'cadr poly))
 (apply 'max (mapcar 'car poly)) (apply 'max (mapcar 'cadr poly))))
(defun rf:limit (nx ny) (if (> (* nx ny) 15000) (wm:fail "Motif trop dense : limite de 15000 positions. Diviser le panneau ou augmenter le pas.")))
(defun rf:stroke (a b poly width / parts part)
 (setq parts (wm:clip a b poly))
 (foreach part parts (if (> (distance (car part) (cadr part)) 1e-7) (progn (wm:draw part width nil) (setq rf:count (1+ rf:count))))))

(defun rf:panel-name (stem en / obj lo hi dim index)
 (setq obj (vlax-ename->vla-object en)) (vla-GetBoundingBox obj 'lo 'hi)
 (setq lo (vlax-safearray->list lo) hi (vlax-safearray->list hi)
  dim (strcat (rtos (- (car hi) (car lo)) 2 2) "x" (rtos (- (cadr hi) (cadr lo)) 2 2)) index 1)
 (while (tblsearch "BLOCK" (strcat stem dim "_" (itoa index))) (setq index (1+ index)))
 (strcat stem dim "_" (itoa index)))
(defun rf:panel-name-poly (stem poly / box dim index)
 (setq box (rf:bounds (mapcar '(lambda (q) (wm:add wm:origin (wm:rot q wm:angle))) poly))
  dim (strcat (rtos (- (nth 2 box) (nth 0 box)) 2 2) "x" (rtos (- (nth 3 box) (nth 1 box)) 2 2)) index 1)
 (while (tblsearch "BLOCK" (strcat stem dim "_" (itoa index))) (setq index (1+ index)))
 (strcat stem dim "_" (itoa index)))
(defun rf:hidden-type ()
 (if (not (tblsearch "LTYPE" "JHR_CACHE"))
  (progn (setq wm:changed T)
   (entmake '((0 . "LTYPE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbLinetypeTableRecord")
    (2 . "JHR_CACHE") (70 . 0) (3 . "JHR - fils derriere le cadre, 4 / 2 mm") (72 . 65) (73 . 2) (40 . 6.0)
    (49 . 4.0) (74 . 0) (49 . -2.0) (74 . 0))))))
(defun rf:edge-draw (a b hidden / data)
 (if (> (distance a b) 1e-7)
  (progn (setq data (wm:pline-data (list a b) 0.0 nil))
   (if hidden (setq data (subst '(6 . "JHR_CACHE") (assoc 6 data) data)))
   (setq wm:shapes (cons data wm:shapes) rf:count (1+ rf:count)))))
(defun rf:wire-edge (a b opts / parts part v vv ts lo hi mid t0 t1)
 (if (/= (fix (nth 7 opts)) 2) (rf:edge-draw a b nil)
  (progn (setq v (wm:sub b a) vv (wm:dot v v) ts '(0.0 1.0) parts (wm:clip a b wm:inner))
   (foreach part parts (foreach q part (setq ts (cons (max 0.0 (min 1.0 (/ (wm:dot (wm:sub q a) v) vv))) ts))))
   (setq ts (vl-sort ts '<))
   (while (cdr ts) (setq t0 (car ts) t1 (cadr ts) mid (wm:lerp a b (/ (+ t0 t1) 2.0)))
    (rf:edge-draw (wm:lerp a b t0) (wm:lerp a b t1) (not (wm:inside mid wm:inner))) (setq ts (cdr ts))))))
(defun rf:vertical-edge (part x poly step radius opts / p0 p1 xpos start finish k y cursor lo hi)
 (setq p0 (car part) p1 (cadr part) xpos (car p0) start (cadr p0) finish (cadr p1) cursor start
  k (1- (wm:floor (/ start step))))
 (while (<= (* k step) (+ finish radius)) (setq y (* k step) lo (max start (- y radius)) hi (min finish (+ y radius)))
  (if (and (> hi lo) (wm:inside (list x y) poly))
   (progn (if (> lo cursor) (rf:wire-edge (list xpos cursor) (list xpos lo) opts)) (setq cursor (max cursor hi))))
  (setq k (1+ k)))
 (if (> finish cursor) (rf:wire-edge (list xpos cursor) (list xpos finish) opts)))

(defun rf:square (poly opts / box step d radius k start stop x y side part)
 (setq box (rf:bounds poly) step (+ (nth 0 opts) (nth 2 opts)) d (nth 2 opts) radius (/ d 2.0))
 (rf:limit (+ 3 (fix (/ (- (nth 2 box) (nth 0 box)) step))) (+ 3 (fix (/ (- (nth 3 box) (nth 1 box)) step))))
 (if (= (fix (nth 7 opts)) 2) (rf:hidden-type))
 ;; Horizontal wires are the front family. Back vertical edges stop at their silhouette.
 (setq start (wm:floor (/ (nth 0 box) step)) stop (1+ (fix (/ (nth 2 box) step))) k start)
 (while (<= k stop) (setq x (* k step))
  (foreach side '(-1.0 1.0)
   (foreach part (wm:clip (list (+ x (* side radius)) (nth 1 box)) (list (+ x (* side radius)) (nth 3 box)) poly)
    (rf:vertical-edge part x poly step radius opts)))
  (setq k (1+ k)))
 (setq start (wm:floor (/ (nth 1 box) step)) stop (1+ (fix (/ (nth 3 box) step))) k start)
 (while (<= k stop) (setq y (* k step))
  (foreach side '(-1.0 1.0)
   (foreach part (wm:clip (list (nth 0 box) (+ y (* side radius))) (list (nth 2 box) (+ y (* side radius))) poly)
    (rf:wire-edge (car part) (cadr part) opts)))
  (setq k (1+ k))))
(defun rf:expanded (poly opts / box sx sy col row col0 col1 row0 row1 p q sign)
 (setq box (rf:bounds poly) sx (/ (nth 0 opts) 2.0) sy (/ (nth 1 opts) 2.0)
  col0 (1- (wm:floor (/ (nth 0 box) sx))) col1 (+ 2 (fix (/ (nth 2 box) sx)))
  row0 (1- (wm:floor (/ (nth 1 box) sy))) row1 (+ 2 (fix (/ (nth 3 box) sy))))
 (rf:limit (1+ (- col1 col0)) (1+ (- row1 row0)))
 (setq row row0) (while (<= row row1) (setq col col0)
  (while (<= col col1)
   (if (= (rem (+ row col) 2) 0)
    (progn (setq p (list (* col sx) (* row sy)))
     (foreach sign '(-1 1) (setq q (list (* (1+ col) sx) (* (+ row sign) sy))) (rf:stroke p q poly (nth 2 opts)))))
   (setq col (1+ col))) (setq row (1+ row))))
(defun rf:fits (pts poly / e seg segments total ok)
 (setq ok (vl-every '(lambda (p) (wm:inside p poly)) pts))
 (if ok (foreach e (wm:edges pts)
  (setq segments (wm:clip (car e) (cadr e) poly) total 0.0)
  (foreach seg segments (setq total (+ total (distance (car seg) (cadr seg)))))
  (if (> (- (distance (car e) (cadr e)) total) 1e-7) (setq ok nil)))) ok)
(defun rf:hole-name (a mode) (strcat "JHR_PERFORATION_" (if (= mode 2) "C" "R") (vl-string-translate "." "_" (rtos a 2 6))))
(defun rf:hole-block (a mode / radius shape)
 (setq radius (/ a 2.0))
 (setq shape (if (= mode 2)
  (wm:pline-data (list (list (- radius) (- radius)) (list radius (- radius)) (list radius radius) (list (- radius) radius)) 0.0 T)
  (list '(0 . "CIRCLE") '(100 . "AcDbEntity") '(8 . "0") '(62 . 256) '(6 . "Continuous") '(370 . -1)
   '(100 . "AcDbCircle") '(10 0.0 0.0 0.0) (cons 40 radius))))
 (if (not (tblsearch "BLOCK" (rf:hole-name a mode))) (wm:block (rf:hole-name a mode) (list shape))))
(defun rf:perforated (plate poly opts / box a pitch dy mode radius row col row0 row1 col0 col1 p pts halfshift fits)
 (setq box (rf:bounds poly) a (nth 0 opts) pitch (nth 1 opts) mode (fix (nth 7 opts)) radius (/ a 2.0)
  dy (* pitch (if (= mode 1) (/ (sqrt 3.0) 2.0) 1.0))
  col0 (1- (wm:floor (/ (nth 0 box) pitch))) col1 (1+ (fix (/ (nth 2 box) pitch)))
  row0 (1- (wm:floor (/ (nth 1 box) dy))) row1 (1+ (fix (/ (nth 3 box) dy))))
 (rf:limit (1+ (- col1 col0)) (1+ (- row1 row0)))
 (setq row row0) (while (<= row row1) (setq col col0 halfshift (if (and (= mode 1) (/= (rem row 2) 0)) (/ pitch 2.0) 0.0))
  (while (<= col col1)
   (setq p (list (+ (* col pitch) halfshift) (* row dy)))
   (setq fits (if (= mode 2)
    (rf:fits (mapcar '(lambda(q) (wm:add p q)) (list (list (- radius) (- radius)) (list radius (- radius)) (list radius radius) (list (- radius) radius))) poly)
    (and (wm:inside p poly) (>= (distance p (car (wm:near p poly))) (- radius 1e-7)))))
   (if fits (progn (wm:insert (rf:hole-name a mode) p 0.0) (setq rf:count (1+ rf:count))))
   (setq col (1+ col))) (setq row (1+ row)))
 (if (= rf:count 0) (wm:fail "Aucune perforation complete ne tient avec cette bordure."))
 (wm:draw plate 0.0 T) (rf:hole-block a mode))
(defun rf:designation (v / a b w th mode)
 (setq a (rtos (nth 0 v) 2 3) b (rtos (nth 1 v) 2 3) w (rtos (nth 2 v) 2 3) th (rtos (nth 3 v) 2 3) mode (fix (nth 7 v)))
 (cond ((= *wm:tool* 1) (strcat "Grillage soude carre;ouverture=" a ";fil=" w ";pas=" (rtos (+ (nth 0 v) (nth 2 v)) 2 3) ";mm"))
  ((= *wm:tool* 2) (strcat "Metal deploye;ML=" a ";MW=" b ";laniere_projection=" w ";epaisseur=" th ";aspect=" (if (= mode 0) "aplati" "relief") ";mm"))
  (T (strcat "Tole perforee;" (cond ((= mode 2) "C/U") ((= mode 1) "R/T60") (T "R/U")) ";trou=" a ";entraxe=" b ";epaisseur=" th ";mm"))))
(defun rf:generate (inside outside / opts lo plate poly inset name stem index data ins rf:count)
 (setq wm:reason nil opts (rf:validate (rf:opts)))
 (if (and (= *wm:tool* 1) (= (fix (nth 7 opts)) 0)) (setq outside inside))
 (setq lo (rf:prepare inside outside (* pi (/ (nth 5 opts) 180.0))))
 (setq wm:shapes nil rf:count 0)
 (setq plate (if (> (nth 4 opts) 1e-8) (rf:offset (if (= *wm:tool* 1) outside inside) (nth 4 opts)) (if (= *wm:tool* 1) wm:outer wm:inner)))
 ;; Buffer half the projected strand width to keep all thick strokes inside the panel.
 (setq inset (+ (nth 4 opts) (cond ((= *wm:tool* 3) (nth 6 opts)) ((= *wm:tool* 1) 0.0) (T (/ (nth 2 opts) 2.0)))))
 (setq poly (if (> inset 1e-8) (rf:offset (if (= *wm:tool* 1) outside inside) inset) (if (= *wm:tool* 1) wm:outer wm:inner)))
 (cond ((= *wm:tool* 1) (rf:square poly opts)) ((= *wm:tool* 2) (rf:expanded poly opts)) ((= *wm:tool* 3) (rf:perforated plate poly opts)))
 (if (= rf:count 0) (wm:fail "Aucun motif ne tient dans ce panneau."))
 (setq stem (cond ((= *wm:tool* 1) "PANNEAU_GRILLAGE_CARRE_") ((= *wm:tool* 2) "PANNEAU_METAL_DEPLOYE_") (T "PANNEAU_TOLE_PERFOREE_")))
 (setq name (rf:panel-name-poly stem plate)) (wm:block name (reverse wm:shapes))
 (setq data (wm:insert-data name wm:origin wm:angle)
  data (subst (cons 8 (getvar "CLAYER")) (assoc 8 data) data)
  data (subst (cons 10 (list (car wm:origin) (cadr wm:origin) (caddr lo))) (assoc 10 data) data))
 (entmake data) (setq ins (entlast)) (regapp "JHR_REMPLISSAGE")
 (entmod (append (entget ins) (list (list -3 (append (list "JHR_REMPLISSAGE" (cons 1000 "representation2D;parametres_mm;pas_de_fixations_ajoutees") (cons 1070 *wm:tool*) (cons 1000 (rf:designation opts)))
  (mapcar '(lambda(v) (cons 1040 v)) opts) (list (cons 1005 (cdr (assoc 5 (entget inside)))) (cons 1005 (cdr (assoc 5 (entget outside))))))))))
 (setq *wm:last* ins *rf:last-count* rf:count)
 (princ (strcat "\n" name " : " (itoa rf:count) (if (= *wm:tool* 3) " perforations completes." " segments de remplissage.") " Bloc sur calque courant ; contenu calque 0 / DuCalque.")) ins)
(defun rf:dispatch (inside outside) (if (= *wm:tool* 0) (wm:generate inside outside) (rf:generate inside outside)))
(defun c:JHRMAILLEPARAMCLI (/ choice opts labels out i val)
 (initget "Filet Carre Deploye Perfore")
 (setq choice (getkword "\nOutil [Filet/Carre/Deploye/Perfore] <dernier outil> : "))
 (if choice (setq *wm:tool* (cond ((= choice "Filet") 0) ((= choice "Carre") 1) ((= choice "Deploye") 2) (T 3))))
 (if (= *wm:tool* 0) (c:JHRFILETPARAMCLI)
  (progn (setq opts (rf:opts) i 0 out nil
   labels (cond ((= *wm:tool* 1) '("Ouverture libre carree" nil "Diametre fil" nil "Retrait cadre" "Orientation degres" nil "Selection : 0=un contour, 1=deux visibles, 2=deux caches"))
    ((= *wm:tool* 2) '("Grande diagonale ML" "Petite diagonale MW" "Largeur laniere en projection" "Epaisseur" "Retrait cadre" "Orientation degres" nil "Aspect : 0=aplati, 1=relief"))
    (T '("Diametre ou cote du trou" "Entraxe" nil "Epaisseur" "Retrait cadre" "Orientation degres" "Bordure pleine" "Type : 0=R/U, 1=R/T, 2=C/U"))))
   (foreach label labels (setq val (if label (getreal (strcat "\n" label " <" (rtos (nth i opts) 2 2) "> : "))) out (cons (if val val (nth i opts)) out) i (1+ i)))
   (setq out (reverse out)) (if (= *wm:tool* 1) (setq out (cons (car out) (cons (car out) (cddr out))))) (rf:validate out) (rf:setopts out) (princ "\nParametres memorises. Lancer JHRMAILLECLI."))) (princ))


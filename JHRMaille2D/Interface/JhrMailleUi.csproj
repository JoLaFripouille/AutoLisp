<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>JhrMaillePlugin_v1_4_2_final</AssemblyName><Version>1.4.2</Version>
    <OutputPath>dist/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoCAD>C:/Program Files/Autodesk/AutoCAD 2027</AutoCAD>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Tests/**/*.cs" /><Compile Remove="MathTests/**/*.cs" /><EmbeddedResource Include="JakobWebnet.json" LogicalName="JhrMaille.JakobWebnet.json" /></ItemGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCAD)/accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCAD)/acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCAD)/acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
